# Virtual environments and caches
.venv/
.venv.cuda-backup/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Large artifacts: tracked by checksum, not by git.
# See checkpoints/SHA256SUMS, exports/nf4/manifest.json, and docs/provenance.md.
checkpoints/*.pt
exports/nf4/*.pt
exports/nf4/*.pt.tmp

# Resumable chunk records for the LLM.int8 benchmark.
results/parts/

# The technical reports are distributed through the Zenodo record, not through git.
# They keep a DOI and a CC BY 4.0 licence of their own. The working tree still
# carries them, and zenodo/build_archives.sh picks them up.
reports/

# LaTeX intermediate files.
*.aux
*.log
*.out
*.toc

# OS noise
.DS_Store

# Zenodo deposit archives: build outputs, rebuilt by zenodo/build_archives.sh.
# Their sha256 is recorded in zenodo/METADATA.md.
zenodo/*.zip
